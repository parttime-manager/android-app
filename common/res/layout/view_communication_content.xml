<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    style="@style/ScreenContent">
    <TextView
        style="@style/ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="소통" />

    <LinearLayout
        android:id="@+id/btn_notice_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:minHeight="48dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_notice"
            android:contentDescription="공지사항"
            android:padding="6dp"
            android:src="@drawable/ic_megaphone"
            app:tint="@color/cat_notice" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="공지사항"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="공지사항 전체 보기"
            android:scaleX="-1"
            android:src="@drawable/ic_back"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_notice_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="등록된 공지가 없습니다."
            android:visibility="gone"
            style="@style/EmptyState" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_handover_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:minHeight="48dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_handover"
            android:contentDescription="인수인계"
            android:padding="6dp"
            android:src="@drawable/ic_person"
            app:tint="@color/cat_handover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="인수인계"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="인수인계 전체 보기"
            android:scaleX="-1"
            android:src="@drawable/ic_back"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_handover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_handover_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="등록된 인수인계가 없습니다."
            android:visibility="gone"
            style="@style/EmptyState" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_swap_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:minHeight="48dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_swap"
            android:contentDescription="대타요청"
            android:padding="6dp"
            android:src="@drawable/ic_swap"
            app:tint="@color/cat_swap" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="대타요청"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="대타요청 전체 보기"
            android:scaleX="-1"
            android:src="@drawable/ic_back"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_swap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_swap_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/communication_swap_empty"
            android:visibility="gone"
            style="@style/EmptyState" />
    </LinearLayout>
</LinearLayout>
