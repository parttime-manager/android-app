<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shift_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_gray"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="28dp">
        <include layout="@layout/view_shift_toolbar" />

        <include layout="@layout/view_shift_summary" />

        <!-- detail rows -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="18dp">
            <LinearLayout style="@style/DetailRow">
                <TextView style="@style/DetailKey" android:text="담당 알바" />

                <TextView android:id="@+id/tv_worker" style="@style/DetailVal" android:text="" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btn_edit"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:text="근무 수정"
            style="@style/ActionPrimary" />

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="근무 삭제"
            android:textColor="@color/accent_red"
            style="@style/ActionSecondary" />
    </LinearLayout>
</ScrollView>
